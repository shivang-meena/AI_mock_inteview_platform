```gitignore
# =========================
# Dependencies
# =========================
node_modules/
**/node_modules/

# =========================
# Environment Files
# =========================
.env
.env.local
.env.development.local
.env.production.local
.env.test.local
**/.env

# =========================
# Next.js
# =========================
.next/
out/

# =========================
# Build Output
# =========================
dist/
build/

# =========================
# Logs
# =========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# Cache
# =========================
.cache/
.parcel-cache/
.turbo/
.eslintcache

# =========================
# Coverage
# =========================
coverage/

# =========================
# TypeScript
# =========================
*.tsbuildinfo

# =========================
# OS Files
# =========================
.DS_Store
Thumbs.db

# =========================
# IDE / Editor
# =========================
.vscode/
.idea/
*.swp

# =========================
# Package Manager
# =========================
.pnp
.pnp.js

# =========================
# Temporary Files
# =========================
tmp/
temp/

# =========================
# Uploads (Optional)
# Uncomment if you don't want uploaded files in Git
# =========================
# uploads/

# =========================
# Database (Optional)
# Uncomment if using a local SQLite database
# =========================
# *.sqlite
# *.db
```
