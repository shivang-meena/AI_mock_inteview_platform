{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "**/*.ts",
    "types/**/*.d.ts"
, "genratetoken.js", "jest.config.js"  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}

